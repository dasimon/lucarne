<ui:FluentWindow x:Class="Lucarne.App.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Lucarne.App.Views"
                 xmlns:controls="clr-namespace:Lucarne.App.Controls"
                 xmlns:res="clr-namespace:Lucarne.App.Resources"
                 Title="Lucarne"
                 Width="1280" Height="800"
                 MinWidth="800" MinHeight="500"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <!-- Two columns: the connection pane, a 4 px splitter, and the sessions area — tab strip on
         top, the active session's WindowsFormsHost below. The title bar spans all three so the
         window keeps one continuous drag surface. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- Width and MinWidth are both driven from code: folding the pane (Ctrl+B) sets them
                 to 0, and the saved AppSettings.PaneWidth is applied at startup. -->
            <ColumnDefinition x:Name="PaneColumn" Width="300" MinWidth="220" />
            <ColumnDefinition x:Name="SplitterColumn" Width="4" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- The Icon is not decoration and not inherited: ExtendsContentIntoTitleBar replaces the
             system caption, so the executable's own icon — which WPF hands to every Window whose
             Icon is unset — never reaches this bar. ui:TitleBar draws one only when given one.

             The source is the 32 px bitmap rather than the .ico: pointed at a multi-frame .ico,
             WPF picks a frame on its own terms, whereas a single 32 px image is an exact 2:1
             reduction at 100 % scaling and pixel-for-pixel at 200 %. -->
        <ui:TitleBar Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Title="Lucarne">
            <ui:TitleBar.Icon>
                <!-- No Width or Height: the ui:TitleBar template already lays the icon out in a
                     16 px box, which is the exact half of the 32 px source. Measured on the
                     running window, the mark spans 14 x 13 px — precisely its geometry at 16 px,
                     so the reduction lands on whole pixels and nothing here needs pinning. -->
                <ui:ImageIcon Source="pack://application:,,,/Lucarne;component/Resources/Lucarne-32.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid x:Name="PaneHost" Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <views:ConnectionPane x:Name="Pane" />
            <!-- Shown instead of the pane when the database could not be opened: the
                 window stays usable, there is simply nothing saved to connect to. -->
            <TextBlock x:Name="PaneUnavailable"
                       Visibility="Collapsed"
                       Margin="16" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static res:Strings.Pane_Unavailable}" />

            <!-- The update banner. Under the connection list rather than over the sessions: it takes
                 its height from the list, so arriving or leaving never resizes the remote desktop
                 and never makes a session renegotiate its resolution. Its own surface, not the
                 shared StatusBar, which any other message would overwrite. A Border and not a
                 ui:InfoBar: measured on WPF-UI 4.3.0, the InfoBar template draws its Title and
                 Message only, with no ContentPresenter, so it has nowhere to put a button. -->
            <Border x:Name="UpdateBar" Grid.Row="1"
                    Visibility="Collapsed"
                    Margin="12,8,12,12" Padding="12,10,8,12"
                    CornerRadius="{StaticResource RdRadiusLg}"
                    Background="{DynamicResource RdSurface1}"
                    BorderBrush="{DynamicResource RdBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:SymbolIcon Symbol="ArrowDownload24"
                                   Foreground="{DynamicResource RdAccent}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="UpdateTitle" Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource RdText}" />
                    <ui:Button x:Name="UpdateDismissButton" Grid.Column="2"
                               Width="{StaticResource RdControlHeight}" Height="{StaticResource RdControlHeight}"
                               Padding="0" Margin="4,0,0,0" VerticalAlignment="Top"
                               Appearance="Transparent"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               ToolTip="{x:Static res:Strings.Update_Dismiss}"
                               AutomationProperties.Name="{x:Static res:Strings.Update_Dismiss}"
                               Click="OnUpdateDismissClick" />

                    <!-- What is happening, or how the last attempt ended. -->
                    <TextBlock x:Name="UpdateMessage" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                               Margin="0,4,4,0" TextWrapping="Wrap"
                               FontSize="{StaticResource RdFontMd}"
                               Foreground="{DynamicResource RdTextMuted}"
                               Visibility="Collapsed" />

                    <ProgressBar x:Name="UpdateProgress" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                 Margin="0,8,4,0" Minimum="0" Maximum="1"
                                 Visibility="Collapsed" />

                    <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <ui:Button x:Name="UpdateInstallButton" Margin="0,0,12,0"
                                   Appearance="Primary"
                                   Content="{x:Static res:Strings.Update_Install}"
                                   Click="OnUpdateInstallClick" />
                        <ui:Button x:Name="UpdateCancelButton" Margin="0,0,12,0"
                                   Content="{x:Static res:Strings.Update_Cancel}"
                                   Visibility="Collapsed"
                                   Click="OnUpdateCancelClick" />
                        <!-- A hyperlink, as in the About window: it leaves for the browser. Its address
                             is set from code, and only once it passed UpdateHosts.IsAllowed. -->
                        <TextBlock x:Name="UpdateNotes" VerticalAlignment="Center" Visibility="Collapsed">
                            <Hyperlink x:Name="UpdateNotesLink" RequestNavigate="OnUpdateNotesNavigate">
                                <Run Text="{x:Static res:Strings.Update_ReleaseNotes}" />
                            </Hyperlink>
                        </TextBlock>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter x:Name="PaneSplitter"
                      Grid.Row="1" Grid.Column="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="Transparent"
                      DragCompleted="OnSplitterDragCompleted" />

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- The notice row. Its MinHeight is set by UpdateSessionsArea: a session's worth
                     of RdNoticeHeight while one is open, so an InfoBar arriving or leaving never
                     resizes the remote desktop underneath; nothing while the area is empty. -->
                <RowDefinition x:Name="NoticeRow" Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Session bar: what the active tab is doing, and the commands that act on it. -->
            <Grid Grid.Row="0" Margin="0,0,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- U+E700 = GlobalNavButton (Segoe Fluent Icons, Segoe MDL2 Assets on Win10):
                     the hamburger that folds the pane. Checked means "pane shown". -->
                <!-- A plain button, not a ToggleButton: checked, WPF-UI paints a toggle in the
                     accent, and the fold of a side pane was the loudest thing on the screen — the
                     only accent fill in view, louder than New and than the session. The pane
                     itself shows its state; the hamburger only ever means "fold or unfold". -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button x:Name="PaneToggle"
                               Width="36" Height="32" Padding="0" Margin="0,0,8,0"
                               Icon="{ui:SymbolIcon Navigation24}"
                               ToolTip="{x:Static res:Strings.Shell_PaneToggleToolTip}"
                               AutomationProperties.Name="{x:Static res:Strings.Shell_PaneToggleToolTip}"
                               Click="OnPaneToggleClick" />
                    <!-- The update banner lives in the pane, so a folded pane would hide that there
                         is one. Here because this bar's height never changes: no session resizes.
                         It only unfolds the pane; the banner stays the one place an update runs. -->
                    <ui:Button x:Name="UpdateHintButton"
                               Height="32" Margin="0,0,8,0"
                               Visibility="Collapsed"
                               Content="{x:Static res:Strings.Update_HintButton}"
                               AutomationProperties.Name="{x:Static res:Strings.Update_HintButton}"
                               Click="OnUpdateHintClick">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{DynamicResource RdAccent}" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <!-- What the active tab is, said as three things rather than one sentence: the
                     name in the text colour, the address in the muted one, the state as the pane's
                     own pill — so the bar reads like the row the session came from. Each column is
                     Auto with a ceiling, and the name gives way first: it is the one of the three
                     the tab strip and the scene also say. -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MaxWidth="320" />
                        <ColumnDefinition Width="Auto" MaxWidth="240" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SessionTitle" Grid.Column="0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource RdText}"
                               TextTrimming="CharacterEllipsis"
                               Text="{x:Static res:Strings.Shell_NoSession}" />
                    <TextBlock x:Name="SessionSubtitle" Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource RdTextMuted}"
                               TextTrimming="CharacterEllipsis" />
                    <!-- The pill, or — while it has no word for the state (connecting, closing) —
                         the bar's own sentence in its place. Never both. -->
                    <controls:StatusTag x:Name="SessionStatus" Grid.Column="2" Margin="10,0,0,0" />
                    <TextBlock x:Name="SessionStateText" Grid.Column="2"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource RdTextMuted}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <ui:Button x:Name="ReconnectButton" Grid.Column="2" Margin="8,0,0,0"
                           Content="{x:Static res:Strings.Shell_Reconnect}"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Visibility="Collapsed"
                           ToolTip="{x:Static res:Strings.Shell_ReconnectToolTip}"
                           Click="OnReconnectClick" />

                <ui:Button x:Name="CancelRetryButton" Grid.Column="3" Margin="8,0,0,0"
                           Content="{x:Static res:Strings.Common_Cancel}"
                           Visibility="Collapsed"
                           ToolTip="{x:Static res:Strings.Shell_CancelRetryToolTip}"
                           Click="OnCancelRetryClick" />

                <!-- Three groups, read left to right: what to do with this session, the tools, and
                     leaving it. The hairlines say where one stops; the tools go quiet (transparent)
                     so the two text buttons carry the bar. -->
                <Rectangle Grid.Column="4" Width="1" Height="20" Margin="10,0,2,0" Fill="{DynamicResource RdBorder}" />

                <!-- The palette holds every command, and Ctrl+K alone was easy to forget: this is
                     the way to it that can be seen. -->
                <ui:Button Grid.Column="5" Margin="8,0,0,0"
                           Appearance="Transparent"
                           Icon="{ui:SymbolIcon AppsList24}"
                           ToolTip="{x:Static res:Strings.Shell_PaletteToolTip}"
                           AutomationProperties.Name="{x:Static res:Strings.Shell_PaletteToolTip}"
                           Click="OnCommandPaletteClick" />

                <ui:Button x:Name="DiagnosticsButton" Grid.Column="6" Margin="4,0,0,0"
                           Appearance="Transparent"
                           Icon="{ui:SymbolIcon Copy24}"
                           IsEnabled="False"
                           ToolTip="{x:Static res:Strings.Shell_DiagnosticsToolTip}"
                           AutomationProperties.Name="{x:Static res:Strings.Shell_DiagnosticsToolTip}"
                           Click="OnCopyDiagnosticsClick" />

                <ui:Button Grid.Column="7" Margin="4,0,0,0"
                           Appearance="Transparent"
                           Icon="{ui:SymbolIcon Key24}"
                           ToolTip="{x:Static res:Strings.Shell_CredentialsToolTip}"
                           AutomationProperties.Name="{x:Static res:Strings.Shell_CredentialsToolTip}"
                           Click="OnManageCredentials" />

                <Rectangle Grid.Column="8" Width="1" Height="20" Margin="10,0,2,0" Fill="{DynamicResource RdBorder}" />

                <ui:Button x:Name="DisconnectButton" Grid.Column="9" Margin="8,0,0,0"
                           Content="{x:Static res:Strings.Shell_Disconnect}" IsEnabled="False"
                           Icon="{ui:SymbolIcon PlugDisconnected24}"
                           ToolTip="{x:Static res:Strings.Session_CloseToolTip}"
                           Click="OnDisconnectClick" />
            </Grid>

            <views:SessionTabStrip x:Name="TabStrip" Grid.Row="1" Margin="0,0,12,6" />

            <ui:InfoBar Grid.Row="2" x:Name="StatusBar" Margin="0,0,12,6" IsOpen="False" IsClosable="True" />

            <Grid Grid.Row="3" Margin="0,0,12,12">
                <!-- Sibling of the session area rather than a child of it: the backdrop behind a
                     remote desktop is black, which no theme text colour reads well against. -->
                <!-- The first thing a new user sees is this, over most of the window. A glyph, a
                     title, the one thing to do, and the two keys that do it, drawn as keys with
                     the palette's own cap, so the two surfaces speak with one voice. -->
                <StackPanel x:Name="EmptySessions"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <!-- Desktop24 scaled up, not Desktop48. Measured 2026-09-06: WPF-UI 4.3.0's
                         SymbolExtensions.GetString splits a code point above U+FFFF byte-wise
                         (Desktop48 = U+F083D comes out as U+083D U+000F, not a surrogate pair), so
                         every such symbol draws nothing although the shipped font has the glyph.
                         A symbol above U+FFFF is a blank square in this application until that is
                         fixed upstream; the 24 px glyphs all sit in the base plane. -->
                    <ui:SymbolIcon Symbol="Desktop24"
                                   FontSize="{StaticResource RdGlyphHero}"
                                   Foreground="{DynamicResource RdTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{x:Static res:Strings.Shell_EmptySessionsTitle}"
                               FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource RdText}" />
                    <TextBlock Text="{x:Static res:Strings.Shell_EmptySessions}"
                               HorizontalAlignment="Center" Margin="0,4,0,16"
                               Foreground="{DynamicResource RdTextMuted}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Style="{StaticResource RdKeyCap}">
                            <TextBlock Style="{StaticResource RdKeyCapText}" Text="{x:Static res:Strings.Palette_ShortcutNewConnection}" />
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.Shell_EmptyNewHint}" Margin="8,0,20,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource RdTextMuted}" />
                        <Border Style="{StaticResource RdKeyCap}">
                            <TextBlock Style="{StaticResource RdKeyCapText}" Text="{x:Static res:Strings.Shell_ShortcutPalette}" />
                        </Border>
                        <TextBlock Text="{x:Static res:Strings.Shell_EmptyPaletteHint}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource RdTextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- One child per open session, added by SessionsViewModel; the active one is
                     Visible and the others Hidden. Collapsed when there is no tab at all, so the
                     black rectangle does not sit over the message above. -->
                <Border x:Name="SessionsBorder" CornerRadius="{StaticResource RdRadius}" Background="{DynamicResource RdSessionGround}" Visibility="Collapsed">
                    <Grid>
                        <Grid x:Name="SessionsArea" />
                        <!-- Over the hosts' place, for the active tab while its host is hidden: what
                             the session is doing, instead of the blank the control would paint. The
                             hosts stay in the tree underneath, measured at the area's size, so the
                             resolution they negotiate is the one they will be shown at. -->
                        <views:SessionScene x:Name="Scene" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
